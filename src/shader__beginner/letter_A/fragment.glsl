#version 300 es
/**
 * Some function is done by following the tutorial generated by ChatGPT.
 */

precision highp float;

in  vec2 coord;
out vec4 colour_out;

uniform int   sample_count;
uniform float stroke_width;
uniform vec4  stroke_colour;

struct CubicBezierCurve
{
    vec2 start;
    vec2 end;
    vec2 start_control;
    vec2 end_control;
};

/**
 * Original curve done by Figma.
 * Format: ([start, end, start_control, end_control])[]
 * Using left-upper corner as origin, right is at `(1, 0)`.
 */
const CubicBezierCurve[7] curves = CubicBezierCurve[7](
    // First stroke to left-lower.
    CubicBezierCurve(vec2(0.11, 0.81), vec2(0.19, 0.88), vec2(0.11, 0.87), vec2(0.17, 0.88)),
    // Stroke from left-lower to upper.
    CubicBezierCurve(vec2(0.19, 0.88), vec2(0.86, 0.05), vec2(0.34, 0.88), vec2(0.86, 0.05)),
    // Stroke from upper to right-lower.
    CubicBezierCurve(vec2(0.86, 0.05), vec2(0.58, 0.88), vec2(0.86, 0.05), vec2(0.58, 0.88)),
    // Right-lower to left-middle, starting of the small ellipse.
    CubicBezierCurve(vec2(0.58, 0.88), vec2(0.52, 0.68), vec2(0.58, 0.88), vec2(0.58, 0.78)),
    // Upper part of the ellipse.
    CubicBezierCurve(vec2(0.52, 0.68), vec2(0.34, 0.60), vec2(0.46, 0.58), vec2(0.37, 0.57)),
    // Lower part of the ellipse.
    CubicBezierCurve(vec2(0.34, 0.60), vec2(0.50, 0.71), vec2(0.31, 0.63), vec2(0.35, 0.71)),
    // Last stroke to right.
    CubicBezierCurve(vec2(0.50, 0.71), vec2(0.80, 0.67), vec2(0.63, 0.71), vec2(0.75, 0.69))
);

/**
 * `t` is `0..=1`, stands for progress of drawing the curve from start to end.
 */
vec2 getPointOfCubicBezierCurve(CubicBezierCurve c, float t)
{
    float u = 1.0 - t;

    return u * u * u * c.start
        + 3.0 * u * u * t * c.start_control
        + t * t * t * c.end
        + 3.0 * u * t * t * c.end_control;
}

/**
 * Return the distance from a point to a segment.
 * `seg_start != seg_end`.
 */
float getDistanceToLineSegment(vec2 point, vec2 seg_start, vec2 seg_end)
{
    vec2 segment_vector = seg_end - seg_start;
    vec2 point_vector   = point   - seg_start;

    // Get the projection parameter `t`.
    // Clamped to `0..=1` in order to make closest point on the segment.
    float t = clamp(
        dot(segment_vector, point_vector) / dot(segment_vector, segment_vector),
        0.0, 1.0
    );

    // Get closest point on the segment.
    vec2 closest_point = seg_start + t * segment_vector;

    return distance(point, closest_point);
}

float getSignedDistanceOf(vec2 point, CubicBezierCurve curve)
{
    /** For making segment. */
    vec2  previous_point = curve.start;
    float min_distance = distance(point, curve.start);
    
    // Get segment and calculate the min distance to segment.
    for (int i = 1; i < sample_count + 1; i++)
    {
        float t = float(i) / float(sample_count);
        vec2 current_point = getPointOfCubicBezierCurve(curve, t);
        float distance = getDistanceToLineSegment(point, previous_point, current_point);
        min_distance = min(min_distance, distance);

        // Update previous point for making segment.
        previous_point = current_point;
    }

    // See if it inside stroke.
    // Remember curve has both side.
    return min_distance - stroke_width / 2.0;
}

void main()
{
    // Since the definition of curve used Figma coord system,
    //  need to transform.
    vec2 figma_point = vec2(coord.x, 1.0 - coord.y);
    float signed_distance = getSignedDistanceOf(figma_point, curves[0]);
    // Test on all 7 curves.
    for (int i = 1; i < 7; i++)
    {
        signed_distance = min(signed_distance, getSignedDistanceOf(figma_point, curves[i]));
    }

    // colour_out = signed_distance < 0.0 ? stroke_colour : vec4(0);

    // Anti-aliasing.
    float pixel_width = fwidth(signed_distance);
    float coverage = 1.0 - smoothstep(
        -0.5 * pixel_width, 0.5 * pixel_width,
        signed_distance
    );
    float alpha = stroke_colour.a * coverage;
    colour_out = colour_out = vec4(stroke_colour.rgb * alpha, alpha);
}